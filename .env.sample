
# Database
DB_HOST=
DB_PORT=5432
DB_USER=bot
DB_PASS=bot
DB_NAME=crypto_alerts

# SQLAlchemy URLs (example)
ASYNC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME
SYNC_DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DB_NAME

# Telegram Bot
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# Bybit
BYBIT_BASE_URL=https://api.bybit.com

# LLM (OpenAI)
LLM_ENABLED=true
OPENAI_API_KEY=PUT_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15


# CryptoBot / CryptoPay
CRYPTOBOT_API_TOKEN=PUT_YOUR_CRYPTOBOT_API_TOKEN_HERE
CRYPTOBOT_BASE_URL=https://pay.crypt.bot/api
CRYPTOBOT_TIMEOUT_SECONDS=10

# Webhook
CRYPTOPAY_WEBHOOK_SECRET_PATH=PUT_RANDOM_SECRET_HERE
CRYPTOPAY_WEBHOOK_VERIFY_SIGNATURE=1
